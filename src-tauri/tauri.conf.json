{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatPlus",
  "version": "0.1.0",
  "identifier": "com.origintech.chatplus",
  "build": {
    "beforeDevCommand": "CHATPLUS_VITE_PORT=18772 CHATPLUS_API_ORIGIN=http://127.0.0.1:18773 pnpm --filter frontend dev",
    "beforeBuildCommand": "pnpm --filter frontend build",
    "devUrl": "http://localhost:18772",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChatPlus",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/chatplus-backend"
    ]
  }
}
